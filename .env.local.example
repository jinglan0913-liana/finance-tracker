# Copy this file to ".env.local" and fill in your own values.
#   cp .env.local.example .env.local
#
# Find both values in Supabase:
#   Project Settings -> Data API  (URL)
#   Project Settings -> API Keys  (anon / publishable key)
#
# NEXT_PUBLIC_ means these are sent to the browser. That is correct and
# expected for these two — the anon key is designed to be public.
#
# NEVER put the service_role key in this file or anywhere in this project.
# It bypasses every security rule and must stay server-side only.

NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here
